# linkedin-post-master — Environment Variables
# =============================================
# Port assignment: Backend 8040 | Frontend 3040

# ── Anthropic (required) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── App ports (do not change — shared port registry across all use-cases) ─────
BACKEND_PORT=8040
FRONTEND_PORT=3040
NEXT_PUBLIC_API_URL=http://localhost:8040

# ── LinkedIn App credentials ───────────────────────────────────────────────────
# Create at: https://developer.linkedin.com/apps
# Scopes needed: r_liteprofile, w_member_social
# These are saved to DB via Settings page — optionally put defaults here
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Email (Gmail recommended) ─────────────────────────────────────────────────
# Gmail: Settings → Security → 2FA → App Passwords → Mail / Other
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=          # Gmail App Password (16 chars, no spaces)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
REVIEW_EMAIL=           # Email address that will receive and review blog drafts
FROM_EMAIL=             # Defaults to SMTP_USER if blank
